enum EFont {
    TAHOMA,
    TAHOMABD,
    COUNT
}

namespace renderer {
    namespace fonts {
        bool initialize() {
            globals::fonts[EFont::TAHOMA] = create_font_mem("Tahoma", 10, tahoma_byte_array, true, false);
            globals::fonts[EFont::TAHOMABD] = create_font_mem("Tahoma Bold", 10, tahomabd_byte_array, true, false);

            return true;
        }
    }

    namespace bitmap {
        uint64 cogwheel_bitmap = create_bitmap(cog_wheel_byte_array);
        uint64 hotkey_bitmap = create_bitmap(hotkey_byte_array);

        void draw(const uint64 &in bitmap, vector2 pos, vector2 size, color_t color, bool rounded = false) {
            draw_bitmap(bitmap, int(pos.x), int(pos.y), int(size.x), int(size.y), color.r, color.g, color.b, color.a, rounded);
        }
    }

    namespace text {
        void draw(const string &in text, vector2 pos, color_t color, EFont font = TAHOMA) {
            draw_text(text, int(pos.x), int(pos.y), color.r, color.g, color.b, color.a, globals::fonts[font], 0, 0, 0, 0, 0, 0.0f);
        }

        void draw_outlined(const string &in text, vector2 pos, color_t color, color_t outline_color, EFont font = TAHOMA) {
            draw_text(text, int(pos.x), int(pos.y), color.r, color.g, color.b, color.a, globals::fonts[font], 1, outline_color.r, outline_color.g, outline_color.b, color.a / 2, 1.0f);
        }

        void draw_shadowed(const string &in text, vector2 pos, color_t color, color_t shadow_color, EFont font = TAHOMA, float shadow_amount = 1.0f) {
            draw_text(text, int(pos.x), int(pos.y), color.r, color.g, color.b, color.a, globals::fonts[font], 2, shadow_color.r, shadow_color.g, shadow_color.b, color.a / 2, shadow_amount);
        }

        vector2 get_size(const string &in text, EFont font = TAHOMA) {
            float w, h;
            get_text_size(globals::fonts[font], text, 0, 0, w, h);
            return vector2(w, h);
        }
    }

    namespace rect {
        void draw(vector2 pos, vector2 size, color_t color, float thickness = 1.0f, float rounding = 0.0f, uint8 rounding_flags = 0) {
            draw_rect(int(pos.x), int(pos.y), int(size.x), int(size.y), color.r, color.g, color.b, color.a, thickness, rounding, rounding_flags);
        }

        void draw_outlined(vector2 pos, vector2 size, color_t color, color_t outline_color, float thickness = 1.0f, float outline_thickness = 1.0f, float rounding = 0.0f, uint8 rounding_flags = 0) {
            draw_rect(int(pos.x - 1), int(pos.y - 1), int(size.x + 2), int(size.y + 2), outline_color.r, outline_color.g, outline_color.b, color.a / 2, outline_thickness, rounding, rounding_flags);
            draw_rect(int(pos.x + 1), int(pos.y + 1), int(size.x - 2), int(size.y - 2), outline_color.r, outline_color.g, outline_color.b, color.a / 2, thickness, rounding, rounding_flags);
            draw_rect(int(pos.x), int(pos.y), int(size.x), int(size.y), color.r, color.g, color.b, color.a, thickness, rounding, rounding_flags);
        }

        void draw_filled(vector2 pos, vector2 size, color_t color) {
            draw_rect_filled(int(pos.x), int(pos.y), int(size.x), int(size.y), color.r, color.g, color.b, color.a, 0.0f, 0.0f);
        }

        void draw_filled_rounded(vector2 pos, vector2 size, color_t color, float rounding = 4.0f, uint8 flags = RR_TOP_LEFT | RR_TOP_RIGHT | RR_BOTTOM_LEFT | RR_BOTTOM_RIGHT) {
            draw_rect_filled(int(pos.x), int(pos.y), int(size.x), int(size.y), color.r, color.g, color.b, color.a, rounding, flags);
        }

        void draw_glow(vector2 pos, vector2 size, color_t color, float rounding = 4.0f, int layers = 6) {
            for (int i = layers; i >= 1; i--) {
                float expand = float(i) * 2;
                uint8 a = uint8(float(color.a) / float(i * 2));
                draw_rect_filled(
                    int(pos.x - expand), int(pos.y - expand),
                    int(size.x + expand * 2), int(size.y + expand * 2),
                    color.r, color.g, color.b, a,
                    rounding + expand, 0
                );
            }
        }

        void draw_cornered(vector2 pos, vector2 size, color_t color, color_t outline_color) {
            int x = int(pos.x);
            int y = int(pos.y);
            int w = int(size.x);
            int h = int(size.y);
            int cornerLen = w < h ? w / 4 : h / 4;
            if (cornerLen < 5) cornerLen = 5;
            int t = 1;

            draw_rect_filled(x - 1, y - 1, cornerLen + 2, t + 2, outline_color.r, outline_color.g, outline_color.b, outline_color.a / 2, 0, 0);
            draw_rect_filled(x - 1, y, t + 2, cornerLen + 1, outline_color.r, outline_color.g, outline_color.b, outline_color.a / 2, 0, 0);
            draw_rect_filled(x + w - cornerLen - 1, y - 1, cornerLen + 2, t + 2, outline_color.r, outline_color.g, outline_color.b, outline_color.a / 2, 0, 0);
            draw_rect_filled(x + w - t - 1, y, t + 2, cornerLen + 1, outline_color.r, outline_color.g, outline_color.b, outline_color.a / 2, 0, 0);
            draw_rect_filled(x - 1, y + h - t - 1, cornerLen + 2, t + 2, outline_color.r, outline_color.g, outline_color.b, outline_color.a / 2, 0, 0);
            draw_rect_filled(x - 1, y + h - cornerLen - 1, t + 2, cornerLen + 1, outline_color.r, outline_color.g, outline_color.b, outline_color.a / 2, 0, 0);
            draw_rect_filled(x + w - cornerLen - 1, y + h - t - 1, cornerLen + 2, t + 2, outline_color.r, outline_color.g, outline_color.b, outline_color.a / 2, 0, 0);
            draw_rect_filled(x + w - t - 1, y + h - cornerLen - 1, t + 2, cornerLen + 1, outline_color.r, outline_color.g, outline_color.b, outline_color.a / 2, 0, 0);

            draw_rect_filled(x, y, cornerLen, t, color.r, color.g, color.b, color.a, 0, 0);
            draw_rect_filled(x, y, t, cornerLen, color.r, color.g, color.b, color.a, 0, 0);
            draw_rect_filled(x + w - cornerLen, y, cornerLen, t, color.r, color.g, color.b, color.a, 0, 0);
            draw_rect_filled(x + w - t, y, t, cornerLen, color.r, color.g, color.b, color.a, 0, 0);
            draw_rect_filled(x, y + h - t, cornerLen, t, color.r, color.g, color.b, color.a, 0, 0);
            draw_rect_filled(x, y + h - cornerLen, t, cornerLen, color.r, color.g, color.b, color.a, 0, 0);
            draw_rect_filled(x + w - cornerLen, y + h - t, cornerLen, t, color.r, color.g, color.b, color.a, 0, 0);
            draw_rect_filled(x + w - t, y + h - cornerLen, t, cornerLen, color.r, color.g, color.b, color.a, 0, 0);
        }

        void draw_gradient(vector2 pos, vector2 size, color_t tl, color_t tr, color_t bl, color_t br, float rounding = 0.0f) {
            draw_four_corner_gradient(
                int(pos.x), int(pos.y), int(size.x), int(size.y),
                tl.r, tl.g, tl.b, tl.a,
                tr.r, tr.g, tr.b, tr.a,
                bl.r, bl.g, bl.b, bl.a,
                br.r, br.g, br.b, br.a,
                rounding
            );
        }
    }

    namespace line {
        void draw(vector2 start, vector2 end, color_t color, float thickness = 1.0f) {
            draw_line(int(start.x), int(start.y), int(end.x), int(end.y), color.r, color.g, color.b, color.a, thickness);
        }
    }

    namespace circle {
        void draw(vector2 center, float radius, color_t color, float thickness = 1.0f, bool filled = false) {
            draw_circle(center.x, center.y, radius, color.r, color.g, color.b, color.a, thickness, filled);
        }
    }
}